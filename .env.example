# Copy to .env and fill in real values. Keep .env out of git.

# Spotify Developer app (https://developer.spotify.com/dashboard/)
SPOTIPY_CLIENT_ID=paste_your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=paste_your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# FreqBlog audio-feature enrichment
FREQBLOG_API_KEY=paste_your_freqblog_api_key_here

# Contact address sent in the MusicBrainz User-Agent (artist-country lookups)
CONTACT_EMAIL=your-email@example.com
